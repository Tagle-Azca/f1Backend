PORT=8741

MONGO_URI=mongodb://localhost:27017/f1_platform

CASSANDRA_HOST=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=f1_telemetry
CASSANDRA_DC=datacenter1

DGRAPH_URL=localhost:9080
# DGRAPH_API_KEY=                  # only needed for Dgraph Cloud

FRONTEND_URL=https://pitwall-intelligence.com

# Required — auth breaks without these (register/login/refresh will fail)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Required for Google sign-in (POST /api/auth/google)
GOOGLE_CLIENT_ID=

# Required to use the /api/admin/* endpoints (sent as the X-Admin-Token header)
ADMIN_SEED_TOKEN=

# Optional
LOG_LEVEL=info
NODE_ENV=development

# Live timing fallback via RapidAPI "F1 Live Pulse" (works from a hosted backend)
RAPIDAPI_KEY=
RAPIDAPI_HOST=
# Path of the Timing Data endpoint (see the RapidAPI code snippet)
RAPIDAPI_TIMING_PATH=/timingData
# Poll interval in ms (watch the plan's request limit)
RAPIDAPI_POLL_MS=10000
# Session Info endpoint (session name, laps, track status) and its poll interval in ms
RAPIDAPI_INFO_PATH=/sessionInfo
RAPIDAPI_INFO_POLL_MS=20000

# Master switch for all live timing calls (F1 SignalR feed + RapidAPI). Off unless "true".
LIVE_TIMING_ENABLED=false
